# Copy this file to `.env` and fill in real values. `.env` is gitignored.
#
# You only need the key for whichever provider you've picked in
# `config.yaml › models.provider` (default: gemini). The other can be
# left blank.

# Default provider — get a free-tier key at https://aistudio.google.com/
GEMINI_API_KEY=

# Optional fallback provider — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the default User-Agent string sent to NWS api.weather.gov.
# NWS requests a descriptive UA with contact info. Defaults to a value built
# from your repo URL + the email in config.yaml if unset.
# NWS_USER_AGENT=(lawn-agents, you@example.com)

# Optional: location of the LanceDB index. Defaults to ./data/index.
# LAWN_AGENTS_INDEX_DIR=./data/index

# Optional: Hugging Face Hub access token. The BGE embedding model
# (BAAI/bge-small-en-v1.5) is cached locally after first download, but
# huggingface_hub still hits HF for metadata checks on every model load.
# Without a token, those requests are unauthenticated and HF prints a
# "Please set a HF_TOKEN to enable higher rate limits" warning every
# run. Get a free read-only token:
#   1. Sign up at https://huggingface.co/ (free)
#   2. Visit https://huggingface.co/settings/tokens
#   3. Create a "Read" token (no write or repo access needed)
#   4. Uncomment + paste below
# Stays out of git: .env is gitignored.
# HF_TOKEN=hf_...
